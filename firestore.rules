rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.shareCode is string &&
             data.shareCode.size() >= 3 &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('email' in data) || data.email is string) &&
             (!('photoUrl' in data) || data.photoUrl is string);
    }

    // User profiles & share codes
    match /users/{userId} {
      allow get: if isAuthenticated() && isValidId(userId);
      allow list: if isAuthenticated();
      allow create, update: if isUser(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isUser(userId);

      // User notifications
      match /notifications/{notificationId} {
        allow read: if isUser(userId);
        allow create: if isAuthenticated() && isValidId(notificationId);
        allow update, delete: if isUser(userId);
      }
    }

    // Collaborator Connections
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );

      allow create: if isAuthenticated() &&
        isValidId(connectionId) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.senderId
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
    }

    // Collaborative Ideas
    match /ideas/{ideaId} {
      // Members can read the idea
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds
      );

      // Creator must be the owner and included in memberIds
      allow create: if isAuthenticated() &&
        isValidId(ideaId) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;

      // Update rules enforcing role permissions:
      // Roles: Owner, Executor (chosen by owner), Contributor
      // All members can add and edit requirements, statuses, notes and resources, and comment.
      // Only the Owner and the Executor can change the idea's execution status (Started, Done, Live).
      // Only the Owner can invite or remove members, change the Executor, or delete the idea.
      allow update: if isAuthenticated() &&
        (request.auth.uid in resource.data.memberIds) &&
        // Rule: Only Creator (Owner) and appointed Executors can change execution status (Started, Done, Live)
        (
          !('executionStatus' in request.resource.data) ||
          request.resource.data.executionStatus == resource.data.executionStatus ||
          request.auth.uid == resource.data.ownerId ||
          (('executorId' in resource.data) && resource.data.executorId != '' && request.auth.uid == resource.data.executorId) ||
          (('executorIds' in resource.data) && (request.auth.uid in resource.data.executorIds))
        ) &&
        // Rule: Only the Creator (Owner) can invite or remove members, or appoint/change Executors
        (
          (
            (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId) &&
            (!('memberIds' in request.resource.data) || request.resource.data.memberIds == resource.data.memberIds) &&
            (!('executorId' in request.resource.data) || !('executorId' in resource.data) || request.resource.data.executorId == resource.data.executorId) &&
            (!('executorIds' in request.resource.data) || !('executorIds' in resource.data) || request.resource.data.executorIds == resource.data.executorIds)
          ) ||
          request.auth.uid == resource.data.ownerId
        );

      // Rule: Only the Owner can delete the idea
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.ownerId;

      // Activity Feed & Comments on each idea
      match /activities/{activityId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/ideas/$(ideaId)).data.memberIds
        );

        allow create: if isAuthenticated() &&
          isValidId(activityId) &&
          (request.auth.uid in get(/databases/$(database)/documents/ideas/$(ideaId)).data.memberIds) &&
          request.resource.data.userId == request.auth.uid;

        allow update, delete: if false; // activity log is append-only
      }
    }
  }
}
